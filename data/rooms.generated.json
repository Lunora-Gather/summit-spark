  "roomGuides": [
    "先把落点站稳，再追求更快。",
    "用第一颗光继建立速度，再用第二颗把落点收稳。",
    "先读两级弹簧的错位落点，过顶后再花冲刺。",
    "先读安全平台线，再把光继点连起来；后半程用冲刺破开金纹门。",
    "先从中棱折回左侧光继；进入长廊后读准相位台亮灭再通过。",
    "用六枚光继分段校准三级弹簧，破门后借相位台收住长房出口。",
    "踩上脆冰就离开，借风升高；后半程沿虚线判断巡游晶核轨迹。",
    "干净进入棱镜；长房后段把破门、晶核与相位台拆成三次判断。",
    "先点亮回声并借风落稳中层；后半程用相位台等待晶核让出路线。",
    "起步先立回声，早段取微光；后半程把破门、相位台、晶核与旧机制连到终点。"
  ],
  "roomPurposes": [
    "信任跳跃弧线和安全落点",
    "用双光继建立速度与恢复的完整句子",
    "用错位双弹簧完成山门终考",
    "读清危险线并串联光继，最后用冲刺破门",
    "用中棱折返，再在长廊读取相位节拍",
    "用六枚光继、三级弹簧、破门与相位台完成旧峰终考",
    "脆冰上果断离开，并在风与巡游晶核之间回高度",
    "用棱镜穿越脆冰，再组合破门、相位与晶核完成风峡终考",
    "掌握回声锚点，在风、相位台与巡游晶核之间稳定回收",
    "用回声保底，把弹簧、光继、风、棱镜、破门、相位与晶核收束到星顶"
  ],
